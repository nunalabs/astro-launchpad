# Dockerfile for Astro Indexer
# Build: docker build -f Dockerfile.indexer -t astro-indexer .
# Run: docker run -p 9090:9090 --env-file .env astro-indexer

FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/shared/package.json ./backend/shared/
COPY backend/indexer/package.json ./backend/indexer/
COPY packages/shared-types/package.json ./packages/shared-types/
RUN pnpm install --frozen-lockfile

# Build
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/backend/shared/node_modules ./backend/shared/node_modules
COPY --from=deps /app/backend/indexer/node_modules ./backend/indexer/node_modules
COPY --from=deps /app/packages/shared-types/node_modules ./packages/shared-types/node_modules
COPY . .

# Generate Prisma client and build
RUN pnpm --filter @astroshibapop/shared exec prisma generate
RUN pnpm --filter @astroshibapop/shared build
RUN pnpm --filter @astroshibapop/indexer build

# Production dependencies
FROM base AS prod-deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/shared/package.json ./backend/shared/
COPY backend/indexer/package.json ./backend/indexer/
COPY packages/shared-types/package.json ./packages/shared-types/
RUN pnpm install --frozen-lockfile --prod

# Production
FROM node:20-alpine AS runner
# Install OpenSSL for Prisma
RUN apk add --no-cache openssl
WORKDIR /app

# Copy package files for proper module resolution
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-workspace.yaml ./

# Copy production node_modules
COPY --from=prod-deps /app/node_modules ./node_modules
# Copy generated Prisma client from builder (overwrites the uninitialized one)
COPY --from=builder /app/node_modules/.pnpm/@prisma+client@5.22.0_prisma@5.22.0/node_modules/.prisma ./node_modules/.pnpm/@prisma+client@5.22.0_prisma@5.22.0/node_modules/.prisma

# Copy shared package (built code from builder, node_modules from prod-deps)
COPY --from=builder /app/backend/shared/dist ./backend/shared/dist
COPY --from=builder /app/backend/shared/package.json ./backend/shared/
COPY --from=builder /app/backend/shared/prisma ./backend/shared/prisma
COPY --from=prod-deps /app/backend/shared/node_modules ./backend/shared/node_modules

# Copy indexer package (built + node_modules)
COPY --from=builder /app/backend/indexer/dist ./backend/indexer/dist
COPY --from=builder /app/backend/indexer/package.json ./backend/indexer/
COPY --from=prod-deps /app/backend/indexer/node_modules ./backend/indexer/node_modules

# Set production environment
ENV NODE_ENV=production

EXPOSE 9090

CMD ["node", "backend/indexer/dist/index.js"]
