{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "astro-launchpad",
  "framework": "nextjs",
  "buildCommand": "pnpm turbo build --filter=web",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install",
  "devCommand": "pnpm dev --filter=web",
  "regions": ["iad1"],
  "env": {
    "STELLAR_NETWORK": "testnet",
    "STELLAR_RPC_URL": "https://soroban-testnet.stellar.org"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_API_URL": "https://api-gateway-v2.vercel.app",
      "NEXT_PUBLIC_GRAPHQL_ENDPOINT": "https://api-gateway-v2.vercel.app/graphql",
      "NEXT_PUBLIC_NETWORK": "testnet",
      "STELLAR_RPC_URL": "https://soroban-testnet.stellar.org"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "https://astro-launchpad-topaz.vercel.app" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Admin-Key, X-Stellar-Address, X-Stellar-Signature, X-Stellar-Timestamp" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/graphql",
      "destination": "https://api-gateway-v2.vercel.app/graphql"
    }
  ]
}
