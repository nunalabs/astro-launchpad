.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Credentials & Secrets - NEVER commit these
.env.credentials
*-credentials*
*.credentials
.secrets
.secrets.*
*secret*.json
*.pem
*.key
*.p12
*.pfx

