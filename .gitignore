# Environment - SECURITY: Never commit secrets
# Use .env.example as template (safe to commit)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Credentials & Secrets - NEVER commit these
.env.credentials
*-credentials*
*.credentials
.secrets
.secrets.*
*secret*.json
*.pem
*.key
*.p12
*.pfx

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Rust/Soroban
target/
Cargo.lock
*.wasm
*.optimized.wasm

# Fuzzing (cargo-fuzz)
fuzz/target/
fuzz/corpus/
fuzz/artifacts/*.profdata
# Keep crash artifacts for regression testing
!fuzz/artifacts/**/crash-*

# SECURITY: Stellar identity files contain secret keys
.stellar/identity/
**/.stellar/identity/
*.toml
# Allow Railway/Nixpacks configuration (safe to commit)
!railway.toml
!**/railway.toml
!nixpacks.toml
!**/nixpacks.toml

