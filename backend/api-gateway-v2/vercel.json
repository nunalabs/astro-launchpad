{
  "version": 2,
  "buildCommand": "npm install --legacy-peer-deps && npx tsc",
  "installCommand": "npm install --legacy-peer-deps",
  "functions": {
    "api/index.js": {
      "maxDuration": 10,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/metrics", "destination": "/api" },
    { "source": "/graphql", "destination": "/api" },
    { "source": "/", "destination": "/api" }
  ]
}