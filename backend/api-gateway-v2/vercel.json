{
  "version": 2,
  "installCommand": "npm install --legacy-peer-deps && npx prisma generate --schema=./prisma/schema.prisma",
  "buildCommand": "echo 'Using pre-compiled JS files'",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["iad1"],
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/graphql",
      "destination": "/api/graphql"
    },
    {
      "source": "/(.*)",
      "destination": "/api/graphql"
    }
  ]
}
