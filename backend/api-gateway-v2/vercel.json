{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 10,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/metrics", "destination": "/api" },
    { "source": "/graphql", "destination": "/api" },
    { "source": "/", "destination": "/api" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}