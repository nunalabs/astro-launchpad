# Force package-lock.json usage
package-lock=true

# Use legacy peer deps to avoid conflicts
legacy-peer-deps=true

# Ensure exact versions from package-lock
save-exact=true

# Don't update package-lock automatically
package-lock-only=false

# Strict engine checking
engine-strict=false

# Use npm registry (not alternative registries)
registry=https://registry.npmjs.org/

# Disable fund messages
fund=false

# Disable audit during install (for faster builds)
audit=false