# Development files
*.md
*.log
.env.example
.env.local
.env.development
.DS_Store

# Source files (we only need compiled output)
src/
tests/
*.test.ts
*.test.js
*.spec.ts
*.spec.js

# Build artifacts that aren't needed
.turbo/
.cache/
coverage/
*.tsbuildinfo

# Development dependencies
.vscode/
.idea/
.git/

# Scripts not needed in production
scripts/pre-deploy-check.sh
scripts/verify-deployment.sh
deploy-vercel.sh
deploy.sh
build.sh

# Documentation
DEPLOY.md
DEPLOYMENT_GUIDE.md
DEPLOY_NOW.md
QUICK_START.md
README_DEPLOY.md

# Config files not needed in deployment
.eslintrc*
.prettierrc*
tsconfig.json
vitest.config.ts

# Node modules will be reinstalled by Vercel
# Don't ignore node_modules entirely as Vercel needs package.json

# Keep these for deployment:
# - api/
# - dist/
# - prisma/
# - node_modules/@prisma/
# - node_modules/.prisma/
# - package.json
# - package-lock.json
# - vercel.json
# - .npmrc