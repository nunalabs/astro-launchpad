generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Token {
  id                String        @id @default(cuid())
  address           String        @unique
  creator           String
  name              String
  symbol            String
  decimals          Int           @default(7)
  totalSupply       String
  metadataUri       String
  imageUrl          String?
  description       String?
  // Social links
  website           String?
  twitter           String?
  telegram          String?
  discord           String?
  circulatingSupply String        @default("0")
  xlmReserve        String        @default("0")
  graduated         Boolean       @default(false)
  xlmRaised         String        @default("0")
  marketCap         String?
  currentPrice      String?
  priceChange24h    Float?
  volume24h         String        @default("0")
  volume7d          String        @default("0")
  holders           Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  poolsToken0       Pool[]        @relation("Token0")
  poolsToken1       Pool[]        @relation("Token1")
  transactions      Transaction[]

  @@index([creator])
  @@index([createdAt])
  @@index([marketCap])
  @@index([volume24h])
  @@index([creator, createdAt, volume24h])
  // Added: indexes for search functionality
  @@index([name])
  @@index([symbol])
  // PERFORMANCE: Index for graduated filter (used in explore page)
  @@index([graduated])
  // PERFORMANCE: Composite index for graduated tokens sorted by date (common query pattern)
  @@index([graduated, createdAt(sort: Desc)])
  // PERFORMANCE: Composite for trending/volume queries
  @@index([graduated, volume24h(sort: Desc)])
  // Soft delete index
  @@index([deletedAt])
}

model Pool {
  id              String           @id @default(cuid())
  address         String           @unique
  token0Address   String
  token1Address   String
  reserve0        String
  reserve1        String
  totalSupply     String
  tvl             String?
  volume24h       String           @default("0")
  volume7d        String           @default("0")
  apr             Float?
  feeRate         Float            @default(0.003) // 0.3% default fee
  fees24h         String           @default("0")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  liquidityEvents LiquidityEvent[]
  token0          Token            @relation("Token0", fields: [token0Address], references: [address])
  token1          Token            @relation("Token1", fields: [token1Address], references: [address])
  swaps           Swap[]

  @@index([token0Address])
  @@index([token1Address])
  @@index([tvl])
  // PERFORMANCE: Composite index for pool queries ordered by creation
  @@index([token0Address, createdAt(sort: Desc)])
  @@index([token1Address, createdAt(sort: Desc)])
  // PERFORMANCE: Index for TVL-based ordering
  @@index([tvl(sort: Desc), createdAt(sort: Desc)])
  // Soft delete index
  @@index([deletedAt])
}

model User {
  id                     String        @id @default(cuid())
  address                String        @unique
  points                 Int           @default(0)
  level                  Int           @default(1)
  referrals              Int           @default(0)
  tokensCreatedCount     Int           @default(0)
  totalVolumeTraded      String        @default("0")
  totalLiquidityProvided String        @default("0")
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  achievements           Achievement[]
  transactions           Transaction[]

  @@index([points])
  @@index([level])
}

model Achievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  name          String
  description   String
  imageUrl      String
  progress      Int       @default(0)
  maxProgress   Int
  completed     Boolean   @default(false)
  unlockedAt    DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
}

model Transaction {
  id           String            @id @default(cuid())
  hash         String            @unique
  type         TransactionType
  from         String
  to           String?
  tokenAddress String?
  amount       String?
  status       TransactionStatus @default(PENDING)
  timestamp    DateTime
  userId       String?
  grossAmount  String?
  lpFee        String?
  netAmount    String?
  protocolFee  String?
  totalFees    String?
  token        Token?            @relation(fields: [tokenAddress], references: [address])
  user         User?             @relation(fields: [userId], references: [id])

  @@index([from])
  @@index([to])
  @@index([timestamp])
  @@index([type])
  @@index([from, type, timestamp, status])
  @@index([type, status, timestamp])
  // PERFORMANCE: Index for token history queries (common pattern)
  @@index([tokenAddress, timestamp(sort: Desc)])
  // PERFORMANCE: Index for token transaction type queries
  @@index([tokenAddress, type, timestamp(sort: Desc)])
}

model Swap {
  id        String   @id @default(cuid())
  hash      String   @unique
  poolId    String
  sender    String
  tokenIn   String
  tokenOut  String
  amountIn  String
  amountOut String
  timestamp DateTime
  pool      Pool     @relation(fields: [poolId], references: [id])

  @@index([poolId])
  @@index([sender])
  @@index([timestamp])
}

model LiquidityEvent {
  id        String             @id @default(cuid())
  hash      String             @unique
  poolId    String
  provider  String
  amount0   String
  amount1   String
  liquidity String
  type      LiquidityEventType
  timestamp DateTime
  pool      Pool               @relation(fields: [poolId], references: [id])

  @@index([poolId])
  @@index([provider])
  @@index([timestamp])
}

model FeeCollection {
  id              String   @id @default(cuid())
  timestamp       DateTime
  tokenAddress    String
  protocolFee     String?
  lpFee           String?
  grossAmount     String
  netAmount       String
  treasuryAddress String?
  createdAt       DateTime @default(now())
  amount          String
  blockNumber     String
  hash            String   @unique
  transactionType String
  type            FeeType
  userAddress     String

  @@index([type])
  @@index([tokenAddress])
  @@index([userAddress])
  @@index([timestamp])
  @@index([type, timestamp])
  @@index([tokenAddress, type, timestamp])
}

model FeeStats {
  id                String   @id @default(cuid())
  tokenAddress      String?  @unique
  totalProtocolFees String   @default("0")
  totalLpFees       String   @default("0")
  totalFees         String   @default("0")
  creationFees24h   String   @default("0")
  creationFees30d   String   @default("0")
  creationFees7d    String   @default("0")
  lpFees24h         String   @default("0")
  lpFees30d         String   @default("0")
  lpFees7d          String   @default("0")
  protocolFees24h   String   @default("0")
  protocolFees30d   String   @default("0")
  protocolFees7d    String   @default("0")
  totalCreationFees String   @default("0")
  totalFees24h      String   @default("0")
  totalFees30d      String   @default("0")
  totalFees7d       String   @default("0")
  totalTransactions Int      @default(0)
  transactions24h   Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@index([tokenAddress])
  @@index([updatedAt])
}

model FeeConfig {
  id              String   @id @default(cuid())
  creationFee     String
  protocolFeeBps  Int
  lpFeeBps        Int
  treasuryAddress String
  effectiveFrom   DateTime
  updatedBy       String?
  createdAt       DateTime @default(now())
  contractAddress String   @unique
  updatedAt       DateTime @updatedAt

  @@index([contractAddress])
  @@index([effectiveFrom])
}

model IndexerState {
  id              String   @id @default(cuid())
  contractName    String   @unique
  lastLedger      String
  lastEventId     String?
  lastProcessedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([contractName])
  @@index([lastProcessedAt])
}

enum FeeType {
  PROTOCOL_FEE
  LP_FEE
  CREATION_FEE
  PROTOCOL_FEE_BUY
  PROTOCOL_FEE_SELL
  LP_FEE_BUY
  LP_FEE_SELL
}

enum TransactionType {
  TOKEN_CREATED
  TOKEN_BOUGHT
  TOKEN_SOLD
  LIQUIDITY_ADDED
  LIQUIDITY_REMOVED
  SWAP
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum LiquidityEventType {
  ADD
  REMOVE
}

// ========== New Event Models ==========

/// Admin events (role changes, ownership transfer)
model AdminEvent {
  id          String         @id @default(cuid())
  type        AdminEventType
  account     String
  role        String?
  previousOwner String?
  newOwner    String?
  executedBy  String
  timestamp   DateTime
  txHash      String?
  blockNumber String?
  createdAt   DateTime       @default(now())

  @@index([type])
  @@index([account])
  @@index([timestamp])
  @@index([type, timestamp])
}

enum AdminEventType {
  ROLE_GRANTED
  ROLE_REVOKED
  OWNERSHIP_TRANSFERRED
  CONTRACT_PAUSED
  CONTRACT_UNPAUSED
}

/// Graduation events (success, failure, recovery)
model GraduationEvent {
  id            String              @id @default(cuid())
  type          GraduationEventType
  tokenAddress  String
  xlmRaised     String?
  tokensGraduated String?
  ammPairAddress String?
  lpTokensBurned String?
  reason        String?
  recoveredBy   String?
  recoveryType  String?
  timestamp     DateTime
  txHash        String?
  blockNumber   String?
  createdAt     DateTime            @default(now())

  @@index([type])
  @@index([tokenAddress])
  @@index([timestamp])
  @@index([tokenAddress, type])
}

enum GraduationEventType {
  GRADUATED
  GRADUATION_DETAILED
  GRADUATION_FAILED
  TOKEN_RECOVERED
  GRADUATION_RETRIED
  BRIDGE_GRADUATION
  GRADUATION_WITH_ASTRO
}

/// ASTRO token events (buyback, liquidity)
model AstroEvent {
  id               String         @id @default(cuid())
  type             AstroEventType
  graduatedToken   String?
  xlmUsed          String?
  astroBurned      String?
  astroAmount      String?
  tokenAmount      String?
  ammPair          String?
  xlmMainPool      String?
  xlmAstroLiquidity String?
  xlmBuyback       String?
  timestamp        DateTime
  txHash           String?
  blockNumber      String?
  createdAt        DateTime       @default(now())

  @@index([type])
  @@index([graduatedToken])
  @@index([timestamp])
}

enum AstroEventType {
  ASTRO_CONFIG_UPDATED
  ASTRO_BUYBACK_EXECUTED
  ASTRO_LIQUIDITY_ADDED
}

/// Config update events (fee changes, address updates)
model ConfigUpdateEvent {
  id              String           @id @default(cuid())
  type            ConfigEventType
  oldValue        String?
  newValue        String?
  oldAddress      String?
  newAddress      String?
  updatedBy       String
  timestamp       DateTime
  txHash          String?
  blockNumber     String?
  createdAt       DateTime         @default(now())

  @@index([type])
  @@index([timestamp])
  @@index([updatedBy])
}

enum ConfigEventType {
  PROTOCOL_FEE_UPDATED
  LP_FEE_UPDATED
  CREATION_FEE_UPDATED
  TREASURY_UPDATED
  GRADUATION_THRESHOLD_UPDATED
  XLM_ADDRESS_UPDATED
  ORACLE_ADDRESS_UPDATED
  AMM_WASM_HASH_UPDATED
  ANTI_WHALE_CONFIG_UPDATED
  MIN_MARKET_CAP_UPDATED
  ORACLE_PRICE_MAX_AGE_UPDATED
  BRIDGE_CONFIG_UPDATED
}
