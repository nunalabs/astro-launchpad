{
  "name": "@astroshibapop/api-gateway-v2",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc",
    "vercel-build": "prisma generate && rm -rf dist && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .turbo node_modules/.prisma",
    "deploy:check": "./scripts/pre-deploy-check.sh",
    "deploy:preview": "vercel",
    "deploy:prod": "vercel --prod",
    "deploy:verify": "./scripts/verify-deployment.sh"
  },
  "dependencies": {
    "@apollo/server": "5.2.0",
    "@as-integrations/express4": "1.1.2",
    "@as-integrations/next": "4.1.0",
    "@prisma/client": "5.22.0",
    "@sentry/node": "10.29.0",
    "@stellar/stellar-base": "^11.0.1",
    "@stellar/stellar-sdk": "^11.2.2",
    "@vercel/kv": "^3.0.0",
    "@vercel/postgres": "0.10.0",
    "apollo-server-micro": "3.13.0",
    "close-with-grace": "^2.1.0",
    "cors": "2.8.5",
    "dataloader": "^2.2.3",
    "dotenv": "^16.3.1",
    "express": "5.1.0",
    "helmet": "^8.0.0",
    "graphql": "^16.9.0",
    "graphql-query-complexity": "^1.1.0",
    "graphql-tag": "2.12.6",
    "ioredis": "^5.3.2",
    "micro": "10.0.1",
    "micro-cors": "0.1.1",
    "next": "16.0.10",
    "pg": "8.16.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/node": "^20.11.0",
    "@types/pg": "8.15.6",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.13",
    "@vercel/node": "^3.0.21",
    "@vitest/ui": "2.1.9",
    "@vitest/coverage-v8": "2.1.9",
    "prisma": "5.22.0",
    "supertest": "^7.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "2.1.9"
  }
}
