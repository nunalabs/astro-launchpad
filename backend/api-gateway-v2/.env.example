# =============================================================================
# ASTRO LAUNCHPAD - API GATEWAY ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# For Vercel: Add these in Dashboard > Settings > Environment Variables

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
NODE_ENV=production

# -----------------------------------------------------------------------------
# DATABASE (Required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string (Supabase, Neon, Prisma Accelerate)
# Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Direct connection (bypasses pooler - for migrations only)
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# -----------------------------------------------------------------------------
# STELLAR/SOROBAN (Required)
# -----------------------------------------------------------------------------
STELLAR_NETWORK=testnet
# Production: STELLAR_NETWORK=mainnet

STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
# Production: STELLAR_RPC_URL="https://soroban.stellar.org"

# Contract addresses (deployed on Stellar)
TOKEN_FACTORY_CONTRACT_ID="CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
AMM_FACTORY_CONTRACT_ID="CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# -----------------------------------------------------------------------------
# REDIS/CACHE (Required for rate limiting in production)
# -----------------------------------------------------------------------------
# Option 1: Vercel KV (recommended for Vercel)
# Get from: Vercel Dashboard > Storage > KV
KV_REST_API_URL="https://your-kv.upstash.io"
KV_REST_API_TOKEN="your-token"

# Option 2: Standard Redis/Upstash
# REDIS_URL="redis://user:password@host:6379"

# -----------------------------------------------------------------------------
# SECURITY (Required in production)
# -----------------------------------------------------------------------------
# Admin API key for protected mutations (min 32 characters)
# Generate with: openssl rand -hex 32
ADMIN_API_KEY="your-secure-admin-key-minimum-32-characters-long"

# Stellar addresses with admin privileges (comma-separated)
ADMIN_ADDRESSES="GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# CORS allowed origins (comma-separated)
CORS_ORIGIN="https://astroshiba.io,https://app.astroshiba.io"

# -----------------------------------------------------------------------------
# GRAPHQL SECURITY
# -----------------------------------------------------------------------------
# IMPORTANT: Disable in production!
GRAPHQL_INTROSPECTION=false
GRAPHQL_PLAYGROUND=false

# Query limits (prevent DoS)
GRAPHQL_MAX_DEPTH=10
GRAPHQL_MAX_COMPLEXITY=5000

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# API SERVER
# -----------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
HEALTH_PORT=4001

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
# Pretty logs (disable in production for JSON output)
LOG_PRETTY=false

# -----------------------------------------------------------------------------
# METRICS (Optional)
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=9090

# -----------------------------------------------------------------------------
# EXTERNAL SERVICES (Optional)
# -----------------------------------------------------------------------------
# Pinata (IPFS for token images)
PINATA_API_KEY=""
PINATA_API_SECRET=""
PINATA_JWT=""

# -----------------------------------------------------------------------------
# SENTRY ERROR MONITORING (Optional)
# -----------------------------------------------------------------------------
# Get your DSN from: https://sentry.io
# 1. Create account at sentry.io
# 2. Create new project (Node.js/Express)
# 3. Copy DSN from project settings
#
# Server-side error tracking
SENTRY_DSN=
#
# For source map uploads (CI/CD only)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# =============================================================================
# VERCEL DEPLOYMENT NOTES
# =============================================================================
# 1. Add all required variables in Vercel Dashboard
# 2. Use different values for Preview vs Production
# 3. DATABASE_URL should use connection pooling (port 6543 for Supabase)
# 4. Never expose ADMIN_API_KEY publicly
# 5. Set GRAPHQL_INTROSPECTION=true only for development environments
