generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Token {
  id                String          @id @default(cuid())
  address           String          @unique
  creator           String
  name              String
  symbol            String
  decimals          Int             @default(7)
  totalSupply       String
  metadataUri       String
  imageUrl          String?
  description       String?
  website           String?
  twitter           String?
  telegram          String?
  discord           String?
  circulatingSupply String          @default("0")
  xlmReserve        String          @default("0")
  graduated         Boolean         @default(false)
  xlmRaised         String          @default("0")
  marketCap         String?
  currentPrice      String?
  priceChange24h    Float?
  volume24h         String          @default("0")
  volume7d          String          @default("0")
  holders           Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  poolsToken0       Pool[]          @relation("Token0")
  poolsToken1       Pool[]          @relation("Token1")
  transactions      Transaction[]
  snapshots         TokenSnapshot[]

  @@index([creator])
  @@index([createdAt])
  @@index([marketCap])
  @@index([volume24h])
  @@index([creator, createdAt, volume24h])
  @@index([name])
  @@index([symbol])
  @@index([graduated])
  @@index([graduated, createdAt(sort: Desc)])
  @@index([graduated, volume24h(sort: Desc)])
  @@index([deletedAt])
}

model TokenSnapshot {
  id                String   @id @default(cuid())
  tokenAddress      String
  timestamp         DateTime
  holders           Int
  currentPrice      String
  marketCap         String
  volume24h         String
  circulatingSupply String
  createdAt         DateTime @default(now())
  token             Token    @relation(fields: [tokenAddress], references: [address], onDelete: Cascade)

  @@unique([tokenAddress, timestamp])
  @@index([tokenAddress, timestamp(sort: Desc)])
}

model Pool {
  id              String           @id @default(cuid())
  address         String           @unique
  token0Address   String
  token1Address   String
  reserve0        String
  reserve1        String
  totalSupply     String
  tvl             String?
  volume24h       String           @default("0")
  volume7d        String           @default("0")
  fees24h         String           @default("0")
  apr             Float?
  feeRate         Float            @default(0.003)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  liquidityEvents LiquidityEvent[]
  token0          Token            @relation("Token0", fields: [token0Address], references: [address], onDelete: Cascade)
  token1          Token            @relation("Token1", fields: [token1Address], references: [address], onDelete: Cascade)
  swaps           Swap[]
  snapshots       PoolSnapshot[]

  @@index([token0Address])
  @@index([token1Address])
  @@index([tvl])
  @@index([token0Address, createdAt(sort: Desc)])
  @@index([token1Address, createdAt(sort: Desc)])
  @@index([tvl(sort: Desc), createdAt(sort: Desc)])
  @@index([deletedAt])
}

model PoolSnapshot {
  id        String   @id @default(cuid())
  poolId    String
  timestamp DateTime
  reserve0  String
  reserve1  String
  tvl       String
  volume24h String
  apr       Float?
  createdAt DateTime @default(now())
  pool      Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([poolId, timestamp])
  @@index([poolId, timestamp(sort: Desc)])
}

model User {
  id                     String                 @id @default(cuid())
  address                String                 @unique
  points                 Int                    @default(0)
  level                  Int                    @default(1)
  referrals              Int                    @default(0)
  tokensCreatedCount     Int                    @default(0)
  totalVolumeTraded      String                 @default("0")
  totalLiquidityProvided String                 @default("0")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  achievements           Achievement[]
  transactions           Transaction[]
  activitySnapshots      UserActivitySnapshot[]

  @@index([points])
  @@index([level])
}

model UserActivitySnapshot {
  id           String   @id @default(cuid())
  userAddress  String
  timestamp    DateTime
  volumeTraded String
  tradesCount  Int
  points       Int
  level        Int
  rank         Int?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userAddress], references: [address], onDelete: Cascade)

  @@unique([userAddress, timestamp])
  @@index([userAddress, timestamp(sort: Desc)])
  @@index([timestamp, rank])
}

model Achievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  name          String
  description   String
  imageUrl      String
  progress      Int       @default(0)
  maxProgress   Int
  completed     Boolean   @default(false)
  unlockedAt    DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model Transaction {
  id           String            @id @default(cuid())
  hash         String            @unique
  type         TransactionType
  from         String
  to           String?
  tokenAddress String?
  amount       String?
  status       TransactionStatus @default(PENDING)
  timestamp    DateTime
  userId       String?
  grossAmount  String?
  lpFee        String?
  netAmount    String?
  protocolFee  String?
  totalFees    String?
  token        Token?            @relation(fields: [tokenAddress], references: [address], onDelete: SetNull)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([from])
  @@index([to])
  @@index([timestamp])
  @@index([type])
  @@index([from, type, timestamp, status])
  @@index([type, status, timestamp])
  @@index([tokenAddress, timestamp(sort: Desc)])
  @@index([tokenAddress, type, timestamp(sort: Desc)])
}

model Swap {
  id        String   @id @default(cuid())
  hash      String   @unique
  poolId    String
  sender    String
  tokenIn   String
  tokenOut  String
  amountIn  String
  amountOut String
  timestamp DateTime
  pool      Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([poolId])
  @@index([sender])
  @@index([timestamp])
}

model LiquidityEvent {
  id        String             @id @default(cuid())
  hash      String             @unique
  poolId    String
  provider  String
  amount0   String
  amount1   String
  liquidity String
  type      LiquidityEventType
  timestamp DateTime
  pool      Pool               @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([poolId])
  @@index([provider])
  @@index([timestamp])
}

model FeeCollection {
  id              String   @id @default(cuid())
  timestamp       DateTime
  tokenAddress    String
  protocolFee     String?
  lpFee           String?
  grossAmount     String
  netAmount       String
  treasuryAddress String?
  createdAt       DateTime @default(now())
  amount          String
  blockNumber     String
  hash            String   @unique
  transactionType String
  type            FeeType
  userAddress     String

  @@index([type])
  @@index([tokenAddress])
  @@index([userAddress])
  @@index([timestamp])
  @@index([type, timestamp])
  @@index([tokenAddress, type, timestamp])
}

model FeeStats {
  id                String   @id @default(cuid())
  tokenAddress      String?  @unique
  totalProtocolFees String   @default("0")
  totalLpFees       String   @default("0")
  totalFees         String   @default("0")
  creationFees24h   String   @default("0")
  creationFees30d   String   @default("0")
  creationFees7d    String   @default("0")
  lpFees24h         String   @default("0")
  lpFees30d         String   @default("0")
  lpFees7d          String   @default("0")
  protocolFees24h   String   @default("0")
  protocolFees30d   String   @default("0")
  protocolFees7d    String   @default("0")
  totalCreationFees String   @default("0")
  totalFees24h      String   @default("0")
  totalFees30d      String   @default("0")
  totalFees7d       String   @default("0")
  totalTransactions Int      @default(0)
  transactions24h   Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@index([tokenAddress])
  @@index([updatedAt])
}

model FeeConfig {
  id              String   @id @default(cuid())
  creationFee     String
  protocolFeeBps  Int
  lpFeeBps        Int
  treasuryAddress String
  effectiveFrom   DateTime
  updatedBy       String?
  createdAt       DateTime @default(now())
  contractAddress String   @unique
  updatedAt       DateTime @updatedAt

  @@index([contractAddress])
  @@index([effectiveFrom])
}

model IndexerState {
  id              String   @id @default(cuid())
  contractName    String   @unique
  lastLedger      String
  lastEventId     String?
  lastProcessedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([contractName])
  @@index([lastProcessedAt])
}

/// Admin events (role changes, ownership transfer)
model AdminEvent {
  id            String         @id @default(cuid())
  type          AdminEventType
  account       String
  role          String?
  previousOwner String?
  newOwner      String?
  executedBy    String
  timestamp     DateTime
  txHash        String?
  blockNumber   String?
  createdAt     DateTime       @default(now())

  @@index([type])
  @@index([account])
  @@index([timestamp])
  @@index([type, timestamp])
}

/// Graduation events (success, failure, recovery)
model GraduationEvent {
  id              String              @id @default(cuid())
  type            GraduationEventType
  tokenAddress    String
  xlmRaised       String?
  tokensGraduated String?
  ammPairAddress  String?
  lpTokensBurned  String?
  reason          String?
  recoveredBy     String?
  recoveryType    String?
  timestamp       DateTime
  txHash          String?
  blockNumber     String?
  createdAt       DateTime            @default(now())

  @@index([type])
  @@index([tokenAddress])
  @@index([timestamp])
  @@index([tokenAddress, type])
}

/// ASTRO token events (buyback, liquidity)
model AstroEvent {
  id                String         @id @default(cuid())
  type              AstroEventType
  graduatedToken    String?
  xlmUsed           String?
  astroBurned       String?
  astroAmount       String?
  tokenAmount       String?
  ammPair           String?
  xlmMainPool       String?
  xlmAstroLiquidity String?
  xlmBuyback        String?
  timestamp         DateTime
  txHash            String?
  blockNumber       String?
  createdAt         DateTime       @default(now())

  @@index([type])
  @@index([graduatedToken])
  @@index([timestamp])
}

/// Config update events (fee changes, address updates)
model ConfigUpdateEvent {
  id          String          @id @default(cuid())
  type        ConfigEventType
  oldValue    String?
  newValue    String?
  oldAddress  String?
  newAddress  String?
  updatedBy   String
  timestamp   DateTime
  txHash      String?
  blockNumber String?
  createdAt   DateTime        @default(now())

  @@index([type])
  @@index([timestamp])
  @@index([updatedBy])
}

enum FeeType {
  PROTOCOL_FEE
  LP_FEE
  CREATION_FEE
  PROTOCOL_FEE_BUY
  PROTOCOL_FEE_SELL
  LP_FEE_BUY
  LP_FEE_SELL
}

enum TransactionType {
  TOKEN_CREATED
  TOKEN_BOUGHT
  TOKEN_SOLD
  LIQUIDITY_ADDED
  LIQUIDITY_REMOVED
  SWAP
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum LiquidityEventType {
  ADD
  REMOVE
}

enum AdminEventType {
  ROLE_GRANTED
  ROLE_REVOKED
  OWNERSHIP_TRANSFERRED
  CONTRACT_PAUSED
  CONTRACT_UNPAUSED
}

enum GraduationEventType {
  GRADUATED
  GRADUATION_DETAILED
  GRADUATION_FAILED
  TOKEN_RECOVERED
  GRADUATION_RETRIED
  BRIDGE_GRADUATION
  GRADUATION_WITH_ASTRO
}

enum AstroEventType {
  ASTRO_CONFIG_UPDATED
  ASTRO_BUYBACK_EXECUTED
  ASTRO_LIQUIDITY_ADDED
}

enum ConfigEventType {
  PROTOCOL_FEE_UPDATED
  LP_FEE_UPDATED
  CREATION_FEE_UPDATED
  TREASURY_UPDATED
  GRADUATION_THRESHOLD_UPDATED
  XLM_ADDRESS_UPDATED
  ORACLE_ADDRESS_UPDATED
  AMM_WASM_HASH_UPDATED
  ANTI_WHALE_CONFIG_UPDATED
  MIN_MARKET_CAP_UPDATED
  ORACLE_PRICE_MAX_AGE_UPDATED
  BRIDGE_CONFIG_UPDATED
}

/// Dead Letter Queue for failed event processing
/// Stores events that failed processing for retry or manual intervention
model FailedEvent {
  id             String            @id @default(cuid())
  eventId        String            @unique /// Original event.id from Stellar
  eventType      String /// token_created, token_buy, token_sell, etc.
  contract       String /// token_factory, amm_factory
  ledger         String /// Ledger sequence number

  /// Event data (JSON)
  eventData      Json /// Full event payload for replay

  /// Error tracking
  errorMessage   String            @db.Text /// Last error message
  errorStack     String?           @db.Text /// Stack trace if available
  failureReason  String /// parsing_error, db_error, rpc_error, etc.

  /// Retry tracking
  retryCount     Int               @default(0) /// Number of retry attempts
  maxRetries     Int               @default(5) /// Maximum retries allowed
  nextRetryAt    DateTime? /// Next scheduled retry (exponential backoff)
  lastRetryAt    DateTime? /// Last retry attempt timestamp

  /// Status
  status         FailedEventStatus @default(PENDING)
  resolvedAt     DateTime? /// When the event was resolved
  resolvedBy     String? /// Admin/system that resolved it
  resolutionNote String?           @db.Text /// Notes about resolution

  /// Metadata
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status])
  @@index([eventType])
  @@index([contract])
  @@index([nextRetryAt])
  @@index([createdAt])
  @@index([status, nextRetryAt]) /// For efficient retry query
  @@index([status, createdAt(sort: Desc)]) /// For listing recent failures
}

enum FailedEventStatus {
  PENDING /// Waiting for retry
  RETRYING /// Currently being retried
  RESOLVED /// Successfully processed
  ABANDONED /// Max retries exceeded, needs manual intervention
  DUPLICATE /// Event already processed (idempotency)
}

/// Ledger Gap Tracking for event indexer reliability
/// Detects and tracks gaps in ledger sequence processing
model LedgerGap {
  id               String          @id @default(cuid())
  contractName     String /// token_factory, amm_factory
  fromLedger       String /// Start of gap (first missing ledger)
  toLedger         String /// End of gap (last missing ledger)
  gapSize          Int /// Number of ledgers in gap

  /// Status
  status           LedgerGapStatus @default(DETECTED)

  /// Timestamps
  detectedAt       DateTime        @default(now())
  recoveredAt      DateTime? /// When gap was recovered
  abandonedAt      DateTime? /// When gap was abandoned

  /// Recovery tracking
  recoveryAttempts Int             @default(0)
  lastRecoveryAt   DateTime?
  eventsRecovered  Int             @default(0) /// Events found during recovery
  lastError        String?         @db.Text
  abandonReason    String?         @db.Text

  /// Metadata
  metadata         Json? /// Additional context (RPC URL, detection method, etc.)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([contractName, fromLedger, toLedger])
  @@index([contractName])
  @@index([status])
  @@index([detectedAt])
  @@index([status, contractName])
  @@index([status, recoveryAttempts]) /// For finding recoverable gaps
}

enum LedgerGapStatus {
  DETECTED /// Gap detected, pending recovery
  RECOVERING /// Currently attempting recovery
  RECOVERED /// Gap successfully recovered
  ABANDONED /// Recovery failed, needs manual review
}
