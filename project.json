{
  "name": "astro-launchpad",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "astro-launchpad",
  "tags": ["scope:launchpad", "type:monorepo", "platform:stellar"],
  "implicitDependencies": ["astro-core"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm -r --filter './apps/*' --filter './packages/*' build"
        ],
        "cwd": "astro-launchpad",
        "parallel": false
      },
      "dependsOn": ["^build", "build-contracts"],
      "outputs": [
        "{projectRoot}/apps/web/.next",
        "{projectRoot}/packages/*/dist",
        "{projectRoot}/contracts/*/target/wasm32-unknown-unknown/release"
      ],
      "cache": true
    },
    "build-contracts": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cargo build --release --target wasm32-unknown-unknown --manifest-path sac-factory/Cargo.toml",
          "cargo build --release --target wasm32-unknown-unknown --manifest-path amm-pair/Cargo.toml",
          "cargo build --release --target wasm32-unknown-unknown -p fee-distributor",
          "cargo build --release --target wasm32-unknown-unknown -p staking-pool",
          "cargo build --release --target wasm32-unknown-unknown -p liquidity-locker",
          "cargo build --release --target wasm32-unknown-unknown -p treasury-vault"
        ],
        "cwd": "astro-launchpad/contracts",
        "parallel": true
      },
      "outputs": ["{projectRoot}/contracts/*/target/wasm32-unknown-unknown/release"],
      "cache": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter web dev",
        "cwd": "astro-launchpad"
      }
    },
    "dev:api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @astroshibapop/api-gateway-v2 dev",
        "cwd": "astro-launchpad"
      }
    },
    "dev:indexer": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @astroshibapop/indexer dev",
        "cwd": "astro-launchpad"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm -r test:run",
        "cwd": "astro-launchpad"
      },
      "cache": true
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm -r test:coverage",
        "cwd": "astro-launchpad"
      },
      "outputs": ["{projectRoot}/coverage"],
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm -r lint",
        "cwd": "astro-launchpad"
      },
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm -r type-check",
        "cwd": "astro-launchpad"
      },
      "cache": true
    },
    "db:migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @astroshibapop/shared prisma migrate dev",
        "cwd": "astro-launchpad"
      }
    },
    "db:studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @astroshibapop/shared prisma studio",
        "cwd": "astro-launchpad"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm -r clean",
          "cd contracts && cargo clean"
        ],
        "cwd": "astro-launchpad",
        "parallel": false
      }
    }
  }
}
