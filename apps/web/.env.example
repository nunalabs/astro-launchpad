# ==============================================
# Astro Launchpad - Environment Variables
# ==============================================
# Copy this file to .env.local for development

# API Gateway
NEXT_PUBLIC_API_GATEWAY_URL=https://api-gateway-v2.vercel.app/graphql

# Stellar Network
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Contract IDs (after deployment)
NEXT_PUBLIC_TOKEN_FACTORY_CONTRACT_ID=CAETFO74SF5GSPA2SCUIR6P5XET6ASEMQPESLRWNWRDC37UX32HBKEMK

# ==============================================
# Sentry Error Monitoring (Optional)
# ==============================================
# Get your DSN from: https://sentry.io
# 1. Create account at sentry.io
# 2. Create new project (Next.js)
# 3. Copy DSN from project settings
#
# Frontend (browser errors)
NEXT_PUBLIC_SENTRY_DSN=
#
# Backend (server-side errors)
SENTRY_DSN=
#
# For source map uploads (CI/CD only)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ==============================================
# Analytics (Optional)
# ==============================================
# NEXT_PUBLIC_GA_TRACKING_ID=
# NEXT_PUBLIC_MIXPANEL_TOKEN=
