# =============================================================================
# ASTRO LAUNCHPAD - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and fill in the values.
#
# This is the SINGLE SOURCE OF TRUTH for environment variables.
# All apps and packages inherit from this file via Turborepo globalDependencies.
# =============================================================================

# -----------------------------------------------------------------------------
# STELLAR NETWORK CONFIGURATION
# -----------------------------------------------------------------------------
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# -----------------------------------------------------------------------------
# SAC FACTORY (TOKEN LAUNCHPAD)
# -----------------------------------------------------------------------------
# The main token factory contract for creating and managing tokens
TOKEN_FACTORY_CONTRACT_ID=YOUR_TOKEN_FACTORY_CONTRACT_ID
SAC_FACTORY_CONTRACT_ID=YOUR_TOKEN_FACTORY_CONTRACT_ID

# -----------------------------------------------------------------------------
# ASTRO TOKEN (PLATFORM TOKEN)
# -----------------------------------------------------------------------------
ASTRO_TOKEN_ADDRESS=YOUR_ASTRO_TOKEN_ADDRESS

# -----------------------------------------------------------------------------
# ASTROSWAP DEX CONTRACTS
# -----------------------------------------------------------------------------
DEX_FACTORY_CONTRACT_ID=YOUR_DEX_FACTORY_CONTRACT_ID
DEX_ROUTER_CONTRACT_ID=YOUR_DEX_ROUTER_CONTRACT_ID
DEX_PAIR_WASM_HASH=YOUR_DEX_PAIR_WASM_HASH

# -----------------------------------------------------------------------------
# OTHER CONTRACTS
# -----------------------------------------------------------------------------
ORACLE_CONTRACT_ID=YOUR_ORACLE_CONTRACT_ID
XLM_SAC_ADDRESS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# -----------------------------------------------------------------------------
# NEXT.JS PUBLIC VARIABLES
# -----------------------------------------------------------------------------
# These are automatically exposed to the browser
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_TOKEN_FACTORY_CONTRACT_ID=YOUR_TOKEN_FACTORY_CONTRACT_ID
NEXT_PUBLIC_DEX_FACTORY_CONTRACT_ID=YOUR_DEX_FACTORY_CONTRACT_ID
NEXT_PUBLIC_DEX_ROUTER_CONTRACT_ID=YOUR_DEX_ROUTER_CONTRACT_ID
NEXT_PUBLIC_XLM_SAC_ADDRESS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
NEXT_PUBLIC_ASTRO_TOKEN_ADDRESS=YOUR_ASTRO_TOKEN_ADDRESS
NEXT_PUBLIC_ORACLE_CONTRACT_ID=YOUR_ORACLE_CONTRACT_ID
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL connection string (Supabase, local, etc.)
DATABASE_URL=postgresql://user:password@localhost:5432/astro_launchpad

# -----------------------------------------------------------------------------
# REDIS (for caching)
# -----------------------------------------------------------------------------
# Local: redis://localhost:6379
# Upstash: https://your-instance.upstash.io with REDIS_TOKEN
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=

# -----------------------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a strong random secret for production!
# Use: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET

# Admin wallet addresses (comma-separated)
ADMIN_ADDRESSES=

# -----------------------------------------------------------------------------
# IPFS/PINATA (for token metadata)
# -----------------------------------------------------------------------------
# Get your JWT from: https://app.pinata.cloud/developers/api-keys
PINATA_JWT=YOUR_PINATA_JWT
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
NEXT_PUBLIC_PINATA_GATEWAY=gateway.pinata.cloud

# -----------------------------------------------------------------------------
# OPTIONAL: ANALYTICS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false
